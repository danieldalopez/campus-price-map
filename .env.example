# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Gemini API (Google AI Studio → Get API key). Server only.
GEMINI_API_KEY=
# Newest stable Flash. Run `node --env-file=.env.local scripts/gemini-check.mjs` to see what your key can use.
GEMINI_MODEL=gemini-flash-latest
# Sticker art (scripts/generate-stickers.mjs). Usually needs billing on the key's project.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Lakebase (Step 3). Native Postgres password roles, see docs/SPEC.md section 5.
DATABASE_URL_READER=
DATABASE_URL_WRITER=
# Local only, never in Vercel. 1 hour OAuth token as the password.
DATABASE_URL_ADMIN=

# live (default) or pipeline
PRICE_SOURCE=live

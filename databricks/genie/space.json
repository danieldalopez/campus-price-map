  "instructions": {
    "text_instructions": [
      {
        "id": "1cb251ec0d568de6a929b520c4aed8d1",
        "content": [
          "## PURPOSE\n- Answer questions about food and drink prices at UBC campus outlets, for students and hackathon judges.\n\n## DISAMBIGUATION\n- \"Campus\" means rows where is_benchmark is false; Save-On-Foods (Wesbrook Village) is the off campus grocery baseline, used only when the user asks about grocery or Save-On-Foods.\n- \"Coffee\" means items I08, I09 (drip coffee), I10 (latte) and I12 (iced coffee or cold brew); tea is not coffee.\n- \"The Nest\" means outlets with area = 'AMS Nest'.\n- When an item name has two sizes (Red Bull), answer for each size.\n\n## DATA QUALITY NOTES\n- Prices reflect the last pipeline refresh (computed_at), not live reports; pending prices are not official.\n- Savings over a term, year or degree assume one purchase a week.\n\n## Instructions you must follow when providing summaries\n- Show prices in CAD with two decimals and name the outlet, not its id.\n- Say \"as of\" the computed_at time."
        ]
      }
    ],
    "example_question_sqls": [
      {
        "id": "18ac2e9bc8aa73214521a7901e8b4513",
        "question": [
          "From INS Market, what is worth walking for?"
        ],
        "sql": [
          "SELECT gold_walk_worth.item_name, gold_walk_worth.cheaper_name, gold_walk_worth.saving, gold_walk_worth.extra_min, gold_walk_worth.saved_term FROM workspace.cpm.gold_walk_worth WHERE gold_walk_worth.origin_location_id = 'ins-market' AND gold_walk_worth.saving_rank = 1 ORDER BY gold_walk_worth.saved_term DESC LIMIT 10"
        ],
        "usage_guidance": [
          "Worth the walk: one suggestion per item and origin is saving_rank = 1. Rank by saved_term for 'over a term'."
        ]
      },
      {
        "id": "611dd1686e36559bc2f29f24cc3492fc",
        "question": [
          "Where is the cheapest small drip coffee?"
        ],
        "sql": [
          "SELECT bronze_items.name, bronze_items.size, bronze_locations.name AS outlet, gold_price_comparisons.price FROM workspace.cpm.gold_price_comparisons JOIN workspace.cpm.bronze_items ON gold_price_comparisons.item_id = bronze_items.id JOIN workspace.cpm.bronze_locations ON gold_price_comparisons.location_id = bronze_locations.id WHERE bronze_items.id = 'I08' AND NOT gold_price_comparisons.is_benchmark AND gold_price_comparisons.rank = 1"
        ],
        "usage_guidance": [
          "Cheapest outlet for one item: filter rank = 1 and exclude the grocery benchmark. Show size, since some names have two sizes."
        ]
      },
      {
        "id": "97af5c2f00ae64182f48b7da9fbe8943",
        "question": [
          "Which outlets are priciest for energy drinks?"
        ],
        "sql": [
          "SELECT bronze_locations.name AS outlet, COUNT(*) AS items, ROUND(AVG(gold_price_comparisons.pct_vs_median), 1) AS avg_pct_vs_median FROM workspace.cpm.gold_price_comparisons JOIN workspace.cpm.bronze_items ON gold_price_comparisons.item_id = bronze_items.id JOIN workspace.cpm.bronze_locations ON gold_price_comparisons.location_id = bronze_locations.id WHERE bronze_items.category = 'Energy drinks' AND NOT gold_price_comparisons.is_benchmark GROUP BY bronze_locations.name HAVING COUNT(*) >= 2 ORDER BY avg_pct_vs_median DESC LIMIT 10"
        ],
        "usage_guidance": [
          "Compare outlets across a group of items with the average pct_vs_median, so items with different prices are comparable. Require at least 2 items."
        ]
      }
    ],
